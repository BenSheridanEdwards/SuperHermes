#!/usr/bin/env bash
# ============================================================================
# new-agent — spin up a new SuperHermes agent from one command.
#
# Provisions the full anatomy (see README + docs/): profile dirs · town-square
# sandbox · gateway launchd plist · Hermes profile
# (config.yaml, SOUL stub) · GBrain config + vault · shared-skills wiring.
# Then (default) starts services + registers launchd.
# Honcho is not provisioned. Memory is GBrain only.
#
# Config: copy superhermes.conf.example → superhermes.conf and set AGENTS_ROOT.
#
# Usage:
#   new-agent                                  # interactive
#   new-agent --name Sky --camp team
#   new-agent --name Sky --no-start            # scaffold only
#   new-agent --name Sky --dry-run             # render to temp, no side effects
#   new-agent --name Sky --yes --no-start      # non-interactive scaffold
#   new-agent --name Sky --provider xai-oauth --model grok-4.3 \
#             --fallback opencode-go:kimi-k2-6 --fallback openai-codex:gpt-5.5 --round-robin
#
# Pauses for the two things it can't autogenerate: credentials (auth.json) and
# the agent's SOUL/persona. (macOS / launchd / sandbox-exec required to start.)
# ============================================================================
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

die(){ printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }
say(){ printf '\033[36m%s\033[0m\n' "$*"; }
ok(){  printf '  \033[32m✓\033[0m %s\n' "$*"; }
plan(){ printf '  \033[33m→\033[0m %s\n' "$*"; }

# ---- config -----------------------------------------------------------------
if [ -f "$REPO/superhermes.conf" ]; then . "$REPO/superhermes.conf"
else say "no superhermes.conf — using example defaults (copy superhermes.conf.example to customize)"; . "$REPO/superhermes.conf.example"; fi
: "${AGENTS_ROOT:?set AGENTS_ROOT in superhermes.conf}"
SKILLS_DIR="${SKILLS_DIR:-}"; GBRAIN_BIN="${GBRAIN_BIN:-}"
HERMES_VENV="${HERMES_VENV:-$HOME/.hermes/hermes-agent/venv}"
REF_AGENT="${REF_AGENT:-}"

# render <template> : substitute __VAR__ from the environment, write to stdout.
render(){ python3 - "$1" <<'PY'
import os,sys,re
t=open(sys.argv[1]).read()
sys.stdout.write(re.sub(r"__([A-Z_]+)__", lambda m: os.environ.get(m.group(1), m.group(0)), t))
PY
}

NAME="" CAMP="" START="yes" DRYRUN=0 YES=0
MODEL_PROVIDER="" MODEL_NAME="" FB1_PROVIDER="" FB1_MODEL="" FB2_PROVIDER="" FB2_MODEL="" ROUNDROBIN=""
while [ $# -gt 0 ]; do case "$1" in
  --name) NAME="${2:-}"; shift 2;; --camp) CAMP="${2:-}"; shift 2;;
  --provider) MODEL_PROVIDER="${2:-}"; shift 2;; --model) MODEL_NAME="${2:-}"; shift 2;;
  --fallback) if [ -z "$FB1_PROVIDER" ]; then FB1_PROVIDER="${2%%:*}"; FB1_MODEL="${2#*:}"; else FB2_PROVIDER="${2%%:*}"; FB2_MODEL="${2#*:}"; fi; shift 2;;
  --round-robin) ROUNDROBIN="y"; shift;;
  --no-start) START="no"; shift;; --start) START="yes"; shift;; --dry-run) DRYRUN=1; shift;;
  --yes|-y) YES=1; shift;;
  -h|--help) sed -n '2,23p' "$0"; exit 0;; *) die "unknown arg: $1";;
esac; done

ask(){ local __v="$1" __p="$2" __d="${3:-}" __r; [ -n "${!__v}" ] && return 0
  if [ "$DRYRUN" = 1 ] || [ "$YES" = 1 ]; then printf -v "$__v" '%s' "$__d"; return 0; fi
  read -r -p "$__p${__d:+ [$__d]}: " __r || true; printf -v "$__v" '%s' "${__r:-$__d}"; }

# ---- collect ----------------------------------------------------------------
say "── new-agent ──────────────────────────────────────────────"
ask NAME "Agent name (PascalCase, e.g. Sky)" "Sky"
[[ "$NAME" =~ ^[A-Za-z][A-Za-z0-9]*$ ]] || die "name must be alphanumeric, start with a letter"
ask CAMP "Camp / workspace suffix (e.g. personal)" "personal"
[[ "$CAMP" =~ ^[a-z][a-z0-9-]*$ ]] || die "camp must be lowercase alphanumeric/hyphen"

# Primary model + up to two fallbacks (+ optional round-robin key rotation),
# asked on EVERY path. Defaults show in [brackets] (never hidden) — and when
# cloning a reference agent they default to THAT agent's model, so accepting
# them clones it verbatim and changing one overrides it. Fleet defaults like
# MiMo are layered on top by the fleet, NOT here — SuperHermes is model-agnostic.
DEF_MP="openai-codex"; DEF_MM="gpt-5.5"; DEF_F1P=""; DEF_F1M=""; DEF_F2P=""; DEF_F2M=""; DEF_RR="N"
if [ -n "$REF_AGENT" ] && [ -d "$AGENTS_ROOT/$REF_AGENT" ]; then
  _rs="$(printf '%s' "$REF_AGENT" | tr '[:upper:]' '[:lower:]')"
  _refmodel="$(python3 "$REPO/bin/set-model-block" read "$AGENTS_ROOT/$REF_AGENT/.hermes/profiles/$_rs/config.yaml" 2>/dev/null || true)"
  if [ -n "$_refmodel" ]; then
    IFS='|' read -r DEF_MP DEF_MM DEF_F1P DEF_F1M DEF_F2P DEF_F2M DEF_RR <<<"$_refmodel"
    [ -n "$DEF_MP" ] || DEF_MP="openai-codex"; [ -n "$DEF_MM" ] || DEF_MM="gpt-5.5"; [ -n "$DEF_RR" ] || DEF_RR="N"
  fi
fi
ask MODEL_PROVIDER "Primary provider" "$DEF_MP"
ask MODEL_NAME     "Primary model" "$DEF_MM"
ask FB1_PROVIDER   "Fallback #1 provider (blank = none)" "$DEF_F1P"
if [ -n "$FB1_PROVIDER" ]; then ask FB1_MODEL "Fallback #1 model" "$DEF_F1M"; fi
ask FB2_PROVIDER   "Fallback #2 provider (blank = none)" "$DEF_F2P"
if [ -n "$FB2_PROVIDER" ]; then ask FB2_MODEL "Fallback #2 model" "$DEF_F2M"; fi
ask ROUNDROBIN     "Round-robin API-key rotation for the provider(s)? (y/N)" "$DEF_RR"

# Build the model YAML block from the answers. `fallback_providers` is the
# gateway's sequential failover chain; `credential_pool_strategies.<provider>:
# round_robin` cycles a provider's API keys evenly instead of fill-first.
MODEL_BLOCK="model:
  provider: ${MODEL_PROVIDER:-openai-codex}
  default: ${MODEL_NAME:-gpt-5.5}"
if { [ -n "$FB1_PROVIDER" ] && [ -n "$FB1_MODEL" ]; } || { [ -n "$FB2_PROVIDER" ] && [ -n "$FB2_MODEL" ]; }; then
  MODEL_BLOCK+="
fallback_providers:"
  if [ -n "$FB1_PROVIDER" ] && [ -n "$FB1_MODEL" ]; then MODEL_BLOCK+="
- provider: $FB1_PROVIDER
  model: $FB1_MODEL"; fi
  if [ -n "$FB2_PROVIDER" ] && [ -n "$FB2_MODEL" ]; then MODEL_BLOCK+="
- provider: $FB2_PROVIDER
  model: $FB2_MODEL"; fi
fi
if [[ "$ROUNDROBIN" =~ ^[Yy] ]]; then
  MODEL_BLOCK+="
credential_pool_strategies:
  ${MODEL_PROVIDER:-openai-codex}: round_robin"
  if [ -n "$FB1_PROVIDER" ]; then MODEL_BLOCK+="
  $FB1_PROVIDER: round_robin"; fi
  if [ -n "$FB2_PROVIDER" ]; then MODEL_BLOCK+="
  $FB2_PROVIDER: round_robin"; fi
fi
export MODEL_BLOCK

export AGENT_NAME="$NAME"
export AGENT_SLUG="$(printf '%s' "$NAME" | tr '[:upper:]' '[:lower:]')"
SLUG="$AGENT_SLUG"
export AGENTS_ROOT
export AGENT_ROOT="$AGENTS_ROOT/$NAME"
export WORKSPACE="$SLUG-$CAMP" AI_PEER="$SLUG"
PROFILE="$AGENT_ROOT/.hermes/profiles/$SLUG"
export WORKSPACE_CWD="$AGENT_ROOT/workspace" SKILLS_DIR GBRAIN_BIN
LA="$HOME/Library/LaunchAgents"

# ---- sandbox boundary blocks ------------------------------------------------
OTHER_AGENT_WRITE_RULES=""
if [ -d "$AGENTS_ROOT" ]; then
  for d in "$AGENTS_ROOT"/*; do
    [ -d "$d" ] || continue
    b="$(basename "$d")"
    [ "$b" = "$NAME" ] && continue
    [ "$b" = "Shared" ] && continue
    [ -d "$d/.hermes" ] || continue
    OTHER_AGENT_WRITE_RULES+="(deny file-write* (literal \"$d\"))"$'\n'
    OTHER_AGENT_WRITE_RULES+="(deny file-write* (subpath \"$d\"))"$'\n'
  done
fi

OTHER_USER_HOME_RULES=""
for d in /Users/*; do
  [ -d "$d" ] || continue
  [ "$d" = "${HOME:-/Users/agents}" ] && continue
  [ "$d" = "/Users/Shared" ] && continue
  OTHER_USER_HOME_RULES+="(deny file* (literal \"$d\"))"$'\n'
  OTHER_USER_HOME_RULES+="(deny file* (subpath \"$d\"))"$'\n'
done
export OTHER_AGENT_WRITE_RULES OTHER_USER_HOME_RULES

# ---- preflight --------------------------------------------------------------
[ -e "$AGENT_ROOT" ] && die "agent dir already exists: $AGENT_ROOT"
[ -f "$REPO/templates/sandbox.sb.template" ] || die "missing bundled sandbox template"
echo; say "Plan for: $NAME"
cat <<SUMMARY
  slug=$SLUG  camp=$CAMP
  root        $AGENT_ROOT
  workspace   $WORKSPACE   aiPeer=$AI_PEER
  memory      GBrain only
  sandbox     allow default; deny /Users/Shared, other user homes, cross-agent writes
  start now   $START$([ "$DRYRUN" = 1 ] && echo "   (DRY-RUN)")
SUMMARY
if [ "$DRYRUN" = 0 ] && [ "$YES" = 0 ]; then read -r -p "Proceed? [y/N] " yn; [[ "$yn" =~ ^[Yy] ]] || die "aborted"; fi
if [ "$DRYRUN" = 1 ]; then TMP="$(mktemp -d)"; AGENT_ROOT="$TMP/$NAME"; export AGENT_ROOT
  PROFILE="$AGENT_ROOT/.hermes/profiles/$SLUG"
  export WORKSPACE_CWD="$AGENT_ROOT/workspace"; LA="$TMP/LaunchAgents"; mkdir -p "$LA"; say "dry-run → $TMP"; fi

# ---- 1. skeleton ------------------------------------------------------------
say "1/7  directory skeleton"
mkdir -p "$PROFILE"/{cron,scripts,logs,memories,home/.gbrain} "$AGENT_ROOT/.hermes/sandbox" \
  "$AGENT_ROOT/.home/.gbrain" \
  "$AGENT_ROOT"/{.cache,.npm,.ollama,tmp,workspace} \
  "$AGENT_ROOT/vault"/{research,assets,sources,logs,published} \
  "$AGENT_ROOT/vault/brain"/{people,projects,guides,tech,daily,companies,concepts,meetings,sources}
render "$REPO/templates/vault.README.md.tmpl" > "$AGENT_ROOT/vault/README.md"
render "$REPO/templates/workspace.README.md.tmpl" > "$AGENT_ROOT/workspace/README.md"
ok "tree under $AGENT_ROOT"

# ---- 2. sandbox -------------------------------------------------------------
say "2/7  sandbox"
render "$REPO/templates/sandbox.sb.template" > "$AGENT_ROOT/.hermes/sandbox/$SLUG.sb"
if command -v sandbox-exec >/dev/null; then
  sandbox-exec -f "$AGENT_ROOT/.hermes/sandbox/$SLUG.sb" /usr/bin/true 2>/dev/null \
    && ok "$SLUG.sb (compiles)" || die "$SLUG.sb failed to compile"
else plan "sandbox-exec unavailable (non-macOS) — rendered but not compile-checked"; fi

# ---- 3. profile -------------------------------------------------------------
say "3/7  Hermes profile"
if [ -n "$REF_AGENT" ] && [ -d "$AGENTS_ROOT/$REF_AGENT" ]; then
  rs="$(printf '%s' "$REF_AGENT" | tr '[:upper:]' '[:lower:]')"
  sed -e "s|$AGENTS_ROOT/$REF_AGENT/|$AGENT_ROOT/|g" \
      -e "s|command: .*/gbrain|command: $AGENT_ROOT/.local/bin/gbrain|" \
      -e "s|^TELEGRAM_HOME_CHANNEL:.*|TELEGRAM_HOME_CHANNEL: ''|" \
      "$AGENTS_ROOT/$REF_AGENT/.hermes/profiles/$rs/config.yaml" > "$PROFILE/config.yaml"
  ok "config.yaml (cloned from $REF_AGENT, paths repointed)"
else
  render "$REPO/templates/config.yaml.tmpl" > "$PROFILE/config.yaml"
  ok "config.yaml (bundled generic template)"
fi
# Install the operator's chosen model over whatever the template/clone produced:
# replaces the model / providers / fallback_providers / credential_pool_strategies
# blocks, preserving every other key. SuperHermes-owned helper (no Fleet dep).
printf '%s\n' "$MODEL_BLOCK" | python3 "$REPO/bin/set-model-block" write "$PROFILE/config.yaml" || die "could not set model block"
ok "model → ${MODEL_PROVIDER:-openai-codex}/${MODEL_NAME:-gpt-5.5}"
python3 "$REPO/bin/set-busy-input-mode" "$PROFILE/config.yaml" steer \
  || die "could not set busy input mode"
ok "busy input → steer"
# Named agents clone a Telegram-enabled reference (Neo). Gateway hard-fails
# startup when telegram.enabled and no bot token (Reflect E2E 2026-07-25).
# Leave messaging OFF until BotFather token is vault-wired; operators enable later.
python3 - "$PROFILE/config.yaml" <<'PYTG' || die "could not disable telegram until token"
import re, sys
from pathlib import Path
p = Path(sys.argv[1])
lines = p.read_text().splitlines()
out = []
in_tg = False
seen = False
enabled_set = False
for line in lines:
    if re.match(r"^telegram:\s*$", line):
        in_tg = True
        seen = True
        out.append(line)
        continue
    if in_tg:
        if line and not line[0].isspace():
            if not enabled_set:
                out.append("  enabled: false")
                enabled_set = True
            in_tg = False
            # fall through to append this non-tg line below
        elif re.match(r"^(\s+)enabled:\s*\S+", line):
            indent = re.match(r"^(\s+)", line).group(1)
            out.append(f"{indent}enabled: false")
            enabled_set = True
            in_tg = False
            continue
        else:
            out.append(line)
            continue
    out.append(line)
if in_tg and not enabled_set:
    out.append("  enabled: false")
    enabled_set = True
if not seen:
    out.append("telegram:")
    out.append("  enabled: false")
text2 = "\n".join(out)
if not text2.endswith("\n"):
    text2 += "\n"
p.write_text(text2)
print("telegram.enabled=false (until bot token)")
PYTG
ok "telegram disabled until bot token (gateway will not hard-fail on missing token)"
cat > "$PROFILE/SOUL.md" <<SOUL
# $NAME

> You are a new soul with unlimited potential. Use your free will to craft your
> soul to partner with your human to achieve incredible things.

<!-- This is yours to write. Grow your identity, voice, and scope as you earn them. -->

## Iron law
No outbound action with real-world consequences — sending, posting, buying,
deleting, changing credentials — without your human's explicit approval.
Earn trust, then earn latitude.

## Worktrees, always
Every change to a git repo starts in a worktree you create under your own
workspace. If a checkout is shared with other processes (crons, other
agents, running services), it stays parked on its default branch at all
times — never \`git switch\`/checkout, commit, or stage work there, and
never in any checkout you did not create yourself.
SOUL
cp "$REPO/templates/MEMORY.template.md" "$PROFILE/memories/MEMORY.md" 2>/dev/null || true
cp "$REPO/templates/USER.template.md"   "$PROFILE/memories/USER.md"   2>/dev/null || true
# profile .env — secret KEYS (Telegram/GitHub/Google). Backend-agnostic: fill here
# or source from a secrets manager via config.yaml `secrets:` (e.g. BitWarden).
render "$REPO/templates/profile.env.tmpl" > "$PROFILE/.env"
# baseline memory crons: daily GBrain consolidation + memory hygiene
export MAINT_ID="$(openssl rand -hex 6 2>/dev/null || echo maint-$SLUG)" \
       SYNC_ID="$(openssl rand -hex 6 2>/dev/null || echo sync-$SLUG)" \
       NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo 1970-01-01T00:00:00Z)"
render "$REPO/templates/cron-jobs.json.tmpl" > "$PROFILE/cron/jobs.json"
# normalised cron scripts: memory-maintenance context snapshot + daily git-sync
render "$REPO/templates/memory-health-snapshot.py.tmpl" > "$PROFILE/scripts/memory_health_snapshot.py"; chmod +x "$PROFILE/scripts/memory_health_snapshot.py"
render "$REPO/templates/cron-registry-snapshot.py.tmpl" > "$PROFILE/scripts/cron_registry_snapshot.py"; chmod +x "$PROFILE/scripts/cron_registry_snapshot.py"
render "$REPO/templates/git-sync.sh.tmpl" > "$PROFILE/scripts/git-sync.sh"; chmod +x "$PROFILE/scripts/git-sync.sh"
python3 "$PROFILE/scripts/cron_registry_snapshot.py" || die "could not snapshot durable cron definitions"
# normalised root .gitignore (default-deny; per-agent copy of the fleet standard)
render "$REPO/templates/gitignore.tmpl" > "$AGENT_ROOT/.gitignore"
ok "SOUL + MEMORY/USER + .env(secret keys) + cron(memory-maintenance + git-sync) + root .gitignore"

# ---- 4. gbrain (profile-isolated v0.41; Postgres fleet standard) ------------
say "4/7  GBrain"
mkdir -p "$PROFILE/home/.gbrain" "$AGENT_ROOT/.local/bin" "$AGENT_ROOT/vault/brain"
# Fleet standard: Postgres at birth (never PGLite). Embed on Ollama :11434/v1.
# Dry-run writes config only; live scaffold also CREATE ROLE/DATABASE.
# Client trees live under .../Clients/<client>/<Name>. Match Fleet identity
# gbrain_<client>_<slug> so pointers and runtime contract never disagree.
# (bash 3.2 + set -u: never expand an empty array.)
GBRAIN_CLIENT_ID=""
case "$AGENT_ROOT" in
  */Clients/*/*)
    _client_id="$(basename "$(dirname "$AGENT_ROOT")")"
    _client_id="$(printf '%s' "$_client_id" | tr '[:upper:]' '[:lower:]')"
    if [[ "$_client_id" =~ ^[a-z][a-z0-9_-]*$ ]]; then
      GBRAIN_CLIENT_ID="$_client_id"
    fi
    ;;
esac
if [ "$DRYRUN" = 1 ]; then
  if [ -n "$GBRAIN_CLIENT_ID" ]; then
    python3 "$REPO/bin/ensure-gbrain-postgres" \
      --slug "$SLUG" --client-id "$GBRAIN_CLIENT_ID" \
      --agent-root "$AGENT_ROOT" --profile-home "$PROFILE/home" --config-only
  else
    python3 "$REPO/bin/ensure-gbrain-postgres" \
      --slug "$SLUG" --agent-root "$AGENT_ROOT" --profile-home "$PROFILE/home" --config-only
  fi
else
  if [ -n "$GBRAIN_CLIENT_ID" ]; then
    python3 "$REPO/bin/ensure-gbrain-postgres" \
      --slug "$SLUG" --client-id "$GBRAIN_CLIENT_ID" \
      --agent-root "$AGENT_ROOT" --profile-home "$PROFILE/home" \
      || die "gbrain postgres provision failed for $SLUG"
  else
    python3 "$REPO/bin/ensure-gbrain-postgres" \
      --slug "$SLUG" --agent-root "$AGENT_ROOT" --profile-home "$PROFILE/home" \
      || die "gbrain postgres provision failed for $SLUG"
  fi
fi
# the agent's OWN wrapper — points only at its own profile-isolated runtime
render "$REPO/templates/gbrain-wrapper.tmpl" > "$AGENT_ROOT/.local/bin/gbrain"
chmod +x "$AGENT_ROOT/.local/bin/gbrain"
printf '# %s - GBrain\n\nKnowledge base index.\n' "$NAME" > "$AGENT_ROOT/vault/brain/HOME.md"
# Guarantee config.yaml carries the correct gbrain MCP block (own wrapper +
# serve + enabled + HOME/HERMES_HOME). Idempotent.
python3 "$REPO/bin/ensure-gbrain-mcp" "$PROFILE/config.yaml" "$AGENT_ROOT" "$PROFILE" || true
ok "gbrain config (postgres + embed :11434/v1) + own wrapper + MCP block + vault/brain"

# ---- 5. launchd plists ------------------------------------------------------
say "5/7  launchd plists"
cat > "$LA/ai.hermes.gateway-$SLUG.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>ai.hermes.gateway-$SLUG</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/sandbox-exec</string><string>-f</string><string>$AGENT_ROOT/.hermes/sandbox/$SLUG.sb</string>
    <string>/Users/agents/Agents/Shared/bin/hermes-gateway-launch</string>
    <string>$SLUG</string><string>$PROFILE</string>
  </array>
  <key>WorkingDirectory</key><string>$AGENT_ROOT/workspace</string>
  <key>EnvironmentVariables</key><dict>
    <key>HERMES_HOME</key><string>$PROFILE</string>
    <key>HOME</key><string>$AGENT_ROOT/.home</string><key>TMPDIR</key><string>$AGENT_ROOT/tmp</string>
    <key>XDG_CACHE_HOME</key><string>$AGENT_ROOT/.cache</string><key>NPM_CONFIG_CACHE</key><string>$AGENT_ROOT/.npm</string>
    <key>VIRTUAL_ENV</key><string>$HERMES_VENV</string>
    <key>PATH</key><string>$HERMES_VENV/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$PROFILE/logs/gateway.log</string>
  <key>StandardErrorPath</key><string>$PROFILE/logs/gateway.error.log</string>
</dict></plist>
PLIST
if command -v plutil >/dev/null; then plutil -lint "$LA/ai.hermes.gateway-$SLUG.plist" >/dev/null && ok "gateway plist (lint clean)"; else ok "gateway plist written"; fi

# ---- 7. perms + git ---------------------------------------------------------
say "6/7  permissions + git"
find "$AGENT_ROOT" -type d -exec chmod 750 {} + 2>/dev/null || true; ok "dirs 750"
# initialise the agent's OWN git repo at its root. The normalised default-deny
# .gitignore means only the durable identity is versioned — secrets, caches, the
# GBrain store, the vault, and workspace clones stay out.
if command -v git >/dev/null && [ ! -d "$AGENT_ROOT/.git" ]; then
  git -C "$AGENT_ROOT" init -q
  git -C "$AGENT_ROOT" add -A
  git -C "$AGENT_ROOT" -c user.name="SuperHermes" -c user.email="superhermes@agents.local" \
      commit -q -m "chore: scaffold $NAME (SuperHermes)" || true
  ok "git initialised at root ($(git -C "$AGENT_ROOT" ls-files 2>/dev/null | wc -l | tr -d ' ') files tracked)"
else plan "git unavailable or repo already exists — skipped init"; fi

# ---- 8. services ------------------------------------------------------------
say "7/7  services"
if [ "$DRYRUN" = 1 ]; then
  plan "install GBrain (profile-isolated) + import vault/brain + embed"
  plan "bootstrap gateway-$SLUG launchd and start gateway"
  say "DRY-RUN complete → $TMP"
elif [ "$START" = "yes" ]; then
  . "$REPO/lib/boot-services.sh" || die "could not source $REPO/lib/boot-services.sh"
  boot_agent_services || die "services boot failed (see above)"
  say "⚠ MANUAL: (1) secrets → $PROFILE/.env — Telegram token from @BotFather  (2) credentials → $PROFILE/auth.json  (3) write $PROFILE/SOUL.md"
else ok "scaffold complete (--no-start)."; fi

echo; say "── $NAME ready ($([ "$DRYRUN" = 1 ] && echo dry-run || echo live)) ──"
