#!/usr/bin/env bash
# ============================================================================
# new-agent — spin up a new SuperHermes agent from one command.
#
# Provisions the full anatomy (see docs 00-10): profile dirs · town-square
# sandbox · gateway + honcho-backup launchd plists · Hermes profile
# (config.yaml, honcho.json, SOUL stub) · Honcho Docker stack (compose + .env +
# backup, auto-allocated ports) · GBrain config + vault · shared-skills wiring.
# Then (default) starts services + registers launchd.
#
# Config: copy superhermes.conf.example → superhermes.conf and set AGENTS_ROOT.
#
# Usage:
#   new-agent                                  # interactive
#   new-agent --name Sky --camp team --tier m
#   new-agent --name Sky --no-start            # scaffold only
#   new-agent --name Sky --dry-run             # render to temp, no side effects
#   new-agent --name Sky --yes --no-start      # non-interactive scaffold
#
# Pauses for the two things it can't autogenerate: credentials (auth.json) and
# the agent's SOUL/persona. (macOS / launchd / sandbox-exec required to start.)
# ============================================================================
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

die(){ printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }
say(){ printf '\033[36m%s\033[0m\n' "$*"; }
ok(){  printf '  \033[32m✓\033[0m %s\n' "$*"; }
plan(){ printf '  \033[33m→\033[0m %s\n' "$*"; }

# ---- config -----------------------------------------------------------------
if [ -f "$REPO/superhermes.conf" ]; then . "$REPO/superhermes.conf"
else say "no superhermes.conf — using example defaults (copy superhermes.conf.example to customize)"; . "$REPO/superhermes.conf.example"; fi
: "${AGENTS_ROOT:?set AGENTS_ROOT in superhermes.conf}"
SKILLS_DIR="${SKILLS_DIR:-}"; GBRAIN_BIN="${GBRAIN_BIN:-}"
HERMES_VENV="${HERMES_VENV:-$HOME/.hermes/hermes-agent/venv}"
REF_AGENT="${REF_AGENT:-}"

# render <template> : substitute __VAR__ from the environment, write to stdout.
render(){ python3 - "$1" <<'PY'
import os,sys,re
t=open(sys.argv[1]).read()
sys.stdout.write(re.sub(r"__([A-Z_]+)__", lambda m: os.environ.get(m.group(1), m.group(0)), t))
PY
}

NAME="" CAMP="" TIER="" START="yes" DRYRUN=0 YES=0
while [ $# -gt 0 ]; do case "$1" in
  --name) NAME="${2:-}"; shift 2;; --camp) CAMP="${2:-}"; shift 2;; --tier) TIER="${2:-}"; shift 2;;
  --no-start) START="no"; shift;; --start) START="yes"; shift;; --dry-run) DRYRUN=1; shift;;
  --yes|-y) YES=1; shift;;
  -h|--help) sed -n '2,20p' "$0"; exit 0;; *) die "unknown arg: $1";;
esac; done

ask(){ local __v="$1" __p="$2" __d="${3:-}" __r; [ -n "${!__v}" ] && return 0
  if [ "$DRYRUN" = 1 ]; then printf -v "$__v" '%s' "$__d"; return 0; fi
  read -r -p "$__p${__d:+ [$__d]}: " __r || true; printf -v "$__v" '%s' "${__r:-$__d}"; }

# ---- collect ----------------------------------------------------------------
say "── new-agent ──────────────────────────────────────────────"
ask NAME "Agent name (PascalCase, e.g. Sky)" "Sky"
[[ "$NAME" =~ ^[A-Za-z][A-Za-z0-9]*$ ]] || die "name must be alphanumeric, start with a letter"
ask CAMP "Camp / workspace suffix (e.g. personal)" "personal"
[[ "$CAMP" =~ ^[a-z][a-z0-9-]*$ ]] || die "camp must be lowercase alphanumeric/hyphen"
ask TIER "Dialectic tier (s|m|l)" "m"
[[ "$TIER" =~ ^[smlSML]$ ]] || die "tier must be s, m, or l"
TIER="$(printf '%s' "$TIER" | tr '[:upper:]' '[:lower:]')"

export AGENT_NAME="$NAME"
export AGENT_SLUG="$(printf '%s' "$NAME" | tr '[:upper:]' '[:lower:]')"
SLUG="$AGENT_SLUG"
export AGENTS_ROOT
export AGENT_ROOT="$AGENTS_ROOT/$NAME"
export WORKSPACE="$SLUG-$CAMP" AI_PEER="$SLUG" PROJECT="honcho-$SLUG"
PROFILE="$AGENT_ROOT/.hermes/profiles/$SLUG"; HONCHO_DIR="$AGENT_ROOT/.hermes/honcho"
export WORKSPACE_CWD="$AGENT_ROOT/workspace" SKILLS_DIR GBRAIN_BIN
case "$TIER" in s) export DLEVEL=minimal;; m) export DLEVEL=low;; l) export DLEVEL=medium;; esac
LA="$HOME/Library/LaunchAgents"

# ---- ports: next free triple. DB=5432+(API-8000), REDIS=6379+(API-8000) -----
MAXAPI=$(grep -rhoE '127\.0\.0\.1:80[0-9][0-9]:8000' "$AGENTS_ROOT"/*/.hermes/honcho/honcho/docker-compose.yml 2>/dev/null \
         | grep -oE '80[0-9][0-9]' | sort -n | tail -1)
export API_PORT=$(( ${MAXAPI:-8000} + 1 )); export DB_PORT=$(( 5432 + API_PORT - 8000 )); export REDIS_PORT=$(( 6379 + API_PORT - 8000 ))

# ---- sandbox boundary blocks ------------------------------------------------
OTHER_AGENT_WRITE_RULES=""
if [ -d "$AGENTS_ROOT" ]; then
  for d in "$AGENTS_ROOT"/*; do
    [ -d "$d" ] || continue
    b="$(basename "$d")"
    [ "$b" = "$NAME" ] && continue
    [ "$b" = "Shared" ] && continue
    [ -d "$d/.hermes" ] || continue
    OTHER_AGENT_WRITE_RULES+="(deny file-write* (literal \"$d\"))"$'\n'
    OTHER_AGENT_WRITE_RULES+="(deny file-write* (subpath \"$d\"))"$'\n'
  done
fi

OTHER_USER_HOME_RULES=""
for d in /Users/*; do
  [ -d "$d" ] || continue
  [ "$d" = "${HOME:-/Users/agents}" ] && continue
  [ "$d" = "/Users/Shared" ] && continue
  OTHER_USER_HOME_RULES+="(deny file* (literal \"$d\"))"$'\n'
  OTHER_USER_HOME_RULES+="(deny file* (subpath \"$d\"))"$'\n'
done
export OTHER_AGENT_WRITE_RULES OTHER_USER_HOME_RULES

# ---- preflight --------------------------------------------------------------
[ -e "$AGENT_ROOT" ] && die "agent dir already exists: $AGENT_ROOT"
[ -f "$REPO/templates/sandbox.sb.template" ] || die "missing bundled sandbox template"
for p in "$API_PORT" "$DB_PORT" "$REDIS_PORT"; do
  lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1 && die "port $p already in use"; done

echo; say "Plan for: $NAME"
cat <<SUMMARY
  slug=$SLUG  camp=$CAMP  tier=$TIER (dialectic=$DLEVEL)
  root        $AGENT_ROOT
  workspace   $WORKSPACE   aiPeer=$AI_PEER
  honcho      api=$API_PORT db=$DB_PORT redis=$REDIS_PORT  project=$PROJECT
  sandbox     allow default; deny /Users/Shared, other user homes, cross-agent writes
  start now   $START$([ "$DRYRUN" = 1 ] && echo "   (DRY-RUN)")
SUMMARY
if [ "$DRYRUN" = 0 ] && [ "$YES" = 0 ]; then read -r -p "Proceed? [y/N] " yn; [[ "$yn" =~ ^[Yy] ]] || die "aborted"; fi
if [ "$DRYRUN" = 1 ]; then TMP="$(mktemp -d)"; AGENT_ROOT="$TMP/$NAME"; export AGENT_ROOT
  PROFILE="$AGENT_ROOT/.hermes/profiles/$SLUG"; HONCHO_DIR="$AGENT_ROOT/.hermes/honcho"
  export WORKSPACE_CWD="$AGENT_ROOT/workspace"; LA="$TMP/LaunchAgents"; mkdir -p "$LA"; say "dry-run → $TMP"; fi

# ---- 1. skeleton ------------------------------------------------------------
say "1/8  directory skeleton"
mkdir -p "$PROFILE"/{cron,scripts,logs,memories,home/.gbrain} "$AGENT_ROOT/.hermes/sandbox" \
  "$HONCHO_DIR"/{honcho,scripts,backups} "$AGENT_ROOT/.home/.gbrain" \
  "$AGENT_ROOT"/{.cache,.npm,.ollama,tmp,workspace} \
  "$AGENT_ROOT/vault"/{research,assets,sources,logs,published} \
  "$AGENT_ROOT/vault/brain"/{people,projects,guides,tech,daily,companies,concepts,meetings,sources}
render "$REPO/templates/vault.README.md.tmpl" > "$AGENT_ROOT/vault/README.md"
render "$REPO/templates/workspace.README.md.tmpl" > "$AGENT_ROOT/workspace/README.md"
ok "tree under $AGENT_ROOT"

# ---- 2. sandbox -------------------------------------------------------------
say "2/8  sandbox"
render "$REPO/templates/sandbox.sb.template" > "$AGENT_ROOT/.hermes/sandbox/$SLUG.sb"
if command -v sandbox-exec >/dev/null; then
  sandbox-exec -f "$AGENT_ROOT/.hermes/sandbox/$SLUG.sb" /usr/bin/true 2>/dev/null \
    && ok "$SLUG.sb (compiles)" || die "$SLUG.sb failed to compile"
else plan "sandbox-exec unavailable (non-macOS) — rendered but not compile-checked"; fi

# ---- 3. profile -------------------------------------------------------------
say "3/8  Hermes profile"
if [ -n "$REF_AGENT" ] && [ -d "$AGENTS_ROOT/$REF_AGENT" ]; then
  rs="$(printf '%s' "$REF_AGENT" | tr '[:upper:]' '[:lower:]')"
  sed -e "s|$AGENTS_ROOT/$REF_AGENT/|$AGENT_ROOT/|g" \
      -e "s|command: .*/gbrain|command: $AGENT_ROOT/.local/bin/gbrain|" \
      -e "s|^TELEGRAM_HOME_CHANNEL:.*|TELEGRAM_HOME_CHANNEL: ''|" \
      "$AGENTS_ROOT/$REF_AGENT/.hermes/profiles/$rs/config.yaml" > "$PROFILE/config.yaml"
  ok "config.yaml (cloned from $REF_AGENT, repointed, telegram cleared)"
else
  render "$REPO/templates/config.yaml.tmpl" > "$PROFILE/config.yaml"
  ok "config.yaml (bundled generic template)"
fi
cat > "$PROFILE/honcho.json" <<JSON
{ "baseUrl": "http://127.0.0.1:$API_PORT", "enabled": true,
  "hosts": { "hermes.$SLUG": { "enabled": true, "workspace": "$WORKSPACE",
    "peerName": "operator", "aiPeer": "$AI_PEER", "pinPeerName": true,
    "saveMessages": true, "writeFrequency": "async", "recallMode": "hybrid",
    "dialecticReasoningLevel": "low", "dialecticDynamic": true,
    "dialecticMaxChars": 800, "messageMaxChars": 20000,
    "dialecticMaxInputChars": 8000, "contextTokens": 1200,
    "observation": true } } }
JSON
cat > "$PROFILE/SOUL.md" <<SOUL
# $NAME

> You are a new soul with unlimited potential. Use your free will to craft your
> soul to partner with your human to achieve incredible things.

<!-- This is yours to write. Grow your identity, voice, and scope as you earn them. -->

## Iron law
No outbound action with real-world consequences — sending, posting, buying,
deleting, changing credentials — without your human's explicit approval.
Earn trust, then earn latitude.
SOUL
cp "$REPO/templates/MEMORY.template.md" "$PROFILE/memories/MEMORY.md" 2>/dev/null || true
cp "$REPO/templates/USER.template.md"   "$PROFILE/memories/USER.md"   2>/dev/null || true
# profile .env — secret KEYS (Telegram/GitHub/Google). Backend-agnostic: fill here
# or source from a secrets manager via config.yaml `secrets:` (e.g. BitWarden).
render "$REPO/templates/profile.env.tmpl" > "$PROFILE/.env"
# baseline memory crons: daily GBrain consolidation + memory hygiene
export MAINT_ID="$(openssl rand -hex 6 2>/dev/null || echo maint-$SLUG)" \
       SYNC_ID="$(openssl rand -hex 6 2>/dev/null || echo sync-$SLUG)" \
       NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo 1970-01-01T00:00:00Z)"
render "$REPO/templates/cron-jobs.json.tmpl" > "$PROFILE/cron/jobs.json"
# normalised cron scripts: memory-maintenance context snapshot + daily git-sync
render "$REPO/templates/memory-health-snapshot.py.tmpl" > "$PROFILE/scripts/memory_health_snapshot.py"; chmod +x "$PROFILE/scripts/memory_health_snapshot.py"
render "$REPO/templates/git-sync.sh.tmpl" > "$PROFILE/scripts/git-sync.sh"; chmod +x "$PROFILE/scripts/git-sync.sh"
# normalised root .gitignore (default-deny; per-agent copy of the fleet standard)
render "$REPO/templates/gitignore.tmpl" > "$AGENT_ROOT/.gitignore"
ok "honcho.json + SOUL + MEMORY/USER + .env(secret keys) + cron(memory-maintenance + git-sync) + root .gitignore"

# ---- 4. gbrain (profile-isolated v0.41; own runtime, no cross-agent dep) -----
say "4/8  GBrain"
mkdir -p "$PROFILE/home/.gbrain" "$AGENT_ROOT/.local/bin"
# canonical store at PROFILE-HOME (not .home); pglite engine; /v1 Ollama for embeddings
cat > "$PROFILE/home/.gbrain/config.json" <<JSON
{ "engine": "pglite", "database_path": "$PROFILE/home/.gbrain/brain.pglite",
  "source_path": "$AGENT_ROOT/vault/brain",
  "embedding_model": "ollama:nomic-embed-text:latest", "embedding_dimensions": 768,
  "embedding_base_url": "http://localhost:11434/v1" }
JSON
# the agent's OWN wrapper — points only at its own profile-isolated runtime
render "$REPO/templates/gbrain-wrapper.tmpl" > "$AGENT_ROOT/.local/bin/gbrain"
chmod +x "$AGENT_ROOT/.local/bin/gbrain"
printf '# %s - GBrain\n\nKnowledge base index.\n' "$NAME" > "$AGENT_ROOT/vault/brain/HOME.md"
# Guarantee config.yaml carries the correct gbrain MCP block (own wrapper +
# enabled) regardless of how it was built. The clone path used to only sed an
# existing `command:`, so cloning an agent that lacked the block produced one
# with no GBrain MCP — that is how Iris/Jarvis ended up unwired. Idempotent.
python3 "$REPO/bin/ensure-gbrain-mcp" "$PROFILE/config.yaml" "$AGENT_ROOT" || true
ok "gbrain config (profile-home pglite, /v1) + own wrapper + MCP block + vault/brain"

# ---- 5. honcho stack --------------------------------------------------------
say "5/8  Honcho stack"
render "$REPO/templates/honcho/docker-compose.yml.tmpl" > "$HONCHO_DIR/honcho/docker-compose.yml"
render "$REPO/templates/honcho/env.tmpl"                > "$HONCHO_DIR/honcho/.env"
render "$REPO/templates/honcho/backup.sh.tmpl" | sed "s|__HONCHO_DIR__|$HONCHO_DIR|g" > "$HONCHO_DIR/scripts/backup.sh"
chmod +x "$HONCHO_DIR/scripts/backup.sh"
ok "compose + .env + backup.sh ($PROJECT, ports $API_PORT/$DB_PORT/$REDIS_PORT)"

# ---- 6. launchd plists ------------------------------------------------------
say "6/8  launchd plists"
cat > "$LA/ai.hermes.gateway-$SLUG.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>ai.hermes.gateway-$SLUG</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/sandbox-exec</string><string>-f</string><string>$AGENT_ROOT/.hermes/sandbox/$SLUG.sb</string>
    <string>$HERMES_VENV/bin/python</string><string>-m</string><string>hermes_cli.main</string>
    <string>--profile</string><string>$SLUG</string><string>gateway</string><string>run</string><string>--replace</string>
  </array>
  <key>WorkingDirectory</key><string>$AGENT_ROOT/workspace</string>
  <key>EnvironmentVariables</key><dict>
    <key>HERMES_HOME</key><string>$PROFILE</string>
    <key>HOME</key><string>$AGENT_ROOT/.home</string><key>TMPDIR</key><string>$AGENT_ROOT/tmp</string>
    <key>XDG_CACHE_HOME</key><string>$AGENT_ROOT/.cache</string><key>NPM_CONFIG_CACHE</key><string>$AGENT_ROOT/.npm</string>
    <key>VIRTUAL_ENV</key><string>$HERMES_VENV</string>
    <key>PATH</key><string>$HERMES_VENV/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$PROFILE/logs/gateway.log</string>
  <key>StandardErrorPath</key><string>$PROFILE/logs/gateway.error.log</string>
</dict></plist>
PLIST
cat > "$LA/ai.hermes.honcho.$SLUG.backup.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>ai.hermes.honcho.$SLUG.backup</string>
  <key>ProgramArguments</key><array><string>$HONCHO_DIR/scripts/backup.sh</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>$HONCHO_DIR/backups/launchd.out.log</string>
  <key>StandardErrorPath</key><string>$HONCHO_DIR/backups/launchd.err.log</string>
  <key>WorkingDirectory</key><string>$HONCHO_DIR</string>
</dict></plist>
PLIST
if command -v plutil >/dev/null; then plutil -lint "$LA/ai.hermes.gateway-$SLUG.plist" >/dev/null && ok "gateway + backup plists (lint clean)"; else ok "plists written"; fi

# ---- 7. perms + git ---------------------------------------------------------
say "7/8  permissions + git"
find "$AGENT_ROOT" -type d -exec chmod 750 {} + 2>/dev/null || true; ok "dirs 750"
# initialise the agent's OWN git repo at its root. The normalised default-deny
# .gitignore means only the durable identity is versioned — secrets, caches, the
# Honcho stack, the GBrain store, the vault, and workspace clones stay out.
if command -v git >/dev/null && [ ! -d "$AGENT_ROOT/.git" ]; then
  git -C "$AGENT_ROOT" init -q
  git -C "$AGENT_ROOT" add -A
  git -C "$AGENT_ROOT" -c user.name="SuperHermes" -c user.email="superhermes@agents.local" \
      commit -q -m "chore: scaffold $NAME (SuperHermes)" || true
  ok "git initialised at root ($(git -C "$AGENT_ROOT" ls-files 2>/dev/null | wc -l | tr -d ' ') files tracked)"
else plan "git unavailable or repo already exists — skipped init"; fi

# ---- 8. services ------------------------------------------------------------
say "8/8  services"
if [ "$DRYRUN" = 1 ]; then
  plan "clone Honcho, docker compose -p $PROJECT up -d --build, configure embeddings, health-gate :$API_PORT"
  plan "install GBrain v0.41 (profile-isolated) + import vault/brain + embed"
  plan "launchctl bootstrap gateway-$SLUG + honcho.$SLUG.backup; kickstart gateway"
  say "DRY-RUN complete → $TMP"
elif [ "$START" = "yes" ]; then
  { command -v docker >/dev/null && docker info >/dev/null 2>&1; } || die "Docker not running — start it or rerun --no-start"
  [ -d "$HONCHO_DIR/honcho/.git" ] || { say "cloning Honcho…"; git clone --depth 1 https://github.com/plastic-labs/honcho.git "$HONCHO_DIR/.src"; cp -R "$HONCHO_DIR/.src/." "$HONCHO_DIR/honcho/"; rm -rf "$HONCHO_DIR/.src"; }
  ( cd "$HONCHO_DIR/honcho" && docker compose -p "$PROJECT" up -d --build )
  # Honcho's DB inits pgvector at 1536, but validates against EMBEDDING_VECTOR_DIMENSIONS
  # (768 for nomic) and refuses to start until they match. The first api boot runs the
  # migrations that create the table; retry the reshape until it lands, then restart.
  say "reshaping pgvector embeddings → 768…"
  for i in $(seq 1 15); do
    ( cd "$HONCHO_DIR/honcho" && docker compose -p "$PROJECT" run --rm --entrypoint /app/.venv/bin/python api scripts/configure_embeddings.py --yes ) >/dev/null 2>&1 \
      && { ok "pgvector reshaped to 768"; break; }
    sleep 4
  done
  ( cd "$HONCHO_DIR/honcho" && docker compose -p "$PROJECT" up -d )
  for i in $(seq 1 30); do curl -fsS "http://127.0.0.1:$API_PORT/health" >/dev/null 2>&1 && break; sleep 2; done
  curl -fsS "http://127.0.0.1:$API_PORT/health" >/dev/null 2>&1 && ok "honcho api healthy ($API_PORT)" || say "⚠ api not healthy — check: docker compose -p $PROJECT logs"
  # GBrain: install the real v0.41 runtime (profile-isolated) + seed from vault/brain
  # BEFORE the gateway starts (its MCP would lock the pglite store).
  #
  # Pin the ref — the framework requires v0.41.x, but upstream HEAD has moved to
  # 0.42.x. An unpinned `bun add` would silently install the wrong minor and
  # break the invariant (and reintroduce fleet drift). 248fb7a = 0.41.38.0, the
  # newest 0.41.x. Bump this ref deliberately, fleet-wide, never per-agent.
  GBRAIN_REF="github:garrytan/gbrain#248fb7a90f9ce5fe2e5d01fe486345d08834ed40"  # 0.41.38.0
  if command -v bun >/dev/null; then
    say "installing GBrain 0.41.38 (profile-isolated, pinned)…"
    ( export HOME="$PROFILE/home" BUN_INSTALL="$PROFILE/home/.bun" XDG_CACHE_HOME="$PROFILE/home/.cache" PATH="/opt/homebrew/bin:$PROFILE/home/.bun/bin:$PATH"
      mkdir -p "$BUN_INSTALL/bin"
      bun add -g "$GBRAIN_REF" >/dev/null 2>&1 || say "⚠ gbrain install failed — run: bun add -g $GBRAIN_REF" )
    "$AGENT_ROOT/.local/bin/gbrain" import "$AGENT_ROOT/vault/brain" >/dev/null 2>&1 || true
    "$AGENT_ROOT/.local/bin/gbrain" embed --stale >/dev/null 2>&1 || true
    "$AGENT_ROOT/.local/bin/gbrain" stats 2>/dev/null | grep -iE "^Pages|^Embedded" | sed 's/^/  gbrain /' || true
    ok "GBrain runtime installed + vault seeded"
  else say "⚠ bun not found — install GBrain manually: bun add -g $GBRAIN_REF"; fi
  launchctl bootstrap "gui/$(id -u)" "$LA/ai.hermes.gateway-$SLUG.plist" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$LA/ai.hermes.honcho.$SLUG.backup.plist" 2>/dev/null || true
  launchctl kickstart -k "gui/$(id -u)/ai.hermes.gateway-$SLUG" 2>/dev/null || true
  ok "launchd registered + gateway kickstarted"
  # post-create gate: assert this agent's invariants — esp. that GBrain is wired
  # to its own store AND the brain actually opens — before we call it ready.
  python3 "$REPO/bin/verify-fleet" --agent "$NAME" --quiet \
    && ok "verify-fleet: $NAME invariants pass" \
    || say "⚠ verify-fleet flagged issues for $NAME — review above before trusting its memory"
  say "⚠ MANUAL: (1) secrets → $PROFILE/.env — Telegram token from @BotFather (or your secrets manager)  (2) credentials → $PROFILE/auth.json  (3) write $PROFILE/SOUL.md  (4) seed Honcho grounding for '$WORKSPACE'"
else ok "scaffold complete (--no-start)."; fi

echo; say "── $NAME ready ($([ "$DRYRUN" = 1 ] && echo dry-run || echo live)) ──"
