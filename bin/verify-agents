#!/usr/bin/env python3
# ============================================================================
# verify-agents — assert SuperHermes invariants across every agent under AGENTS_ROOT.
#
# Fast, no-LLM, no third-party deps (stdlib only). Discovers agents under
# AGENTS_ROOT and checks the invariants the framework depends on. Most of the
# bugs hand-built agents accumulate are config / cross-reference drift, not
# logic bugs — this catches that whole class in one pass.
#
# Exit code: 0 = all checks pass (warnings allowed), 1 = one or more FAILs.
#
# Usage:
#   verify-agents                 # all agents under AGENTS_ROOT
#   verify-agents --agent Iris    # one agent
#   verify-agents --root /path    # override AGENTS_ROOT
#   verify-agents --quiet         # only WARN/FAIL lines + summary
#
# AGENTS_ROOT resolves from: --root → $AGENTS_ROOT → superhermes.conf(.example).
#
# Store checks are engine-aware (per-agent gbrain config.json decides): a
# postgres engine asserts database_url reachability + cross-agent db isolation;
# a pglite engine asserts the store lives inside the agent's own profile.
# RUNTIME_CONTRACT_STATE (env or superhermes.conf) optionally points at the
# runtime reconciler's state JSON; when set, each agent must be enrolled and
# healthy there. Unset (lone agent, no reconciler) skips those checks.
# ============================================================================
import argparse, json, os, re, socket, subprocess, sys, plistlib
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import urlparse

# gbrain binary version per agent, collected during the per-agent pass and
# asserted for consistency in the cross-agent section.
GBRAIN_VERSIONS = {}
# gbrain store identity (host, port, dbname) per agent — asserted distinct in
# the cross-agent section (per-agent isolation on a shared postgres server).
STORE_IDS = {}

C = {"P": "\033[32m", "W": "\033[33m", "F": "\033[31m", "H": "\033[36m", "D": "\033[2m", "x": "\033[0m"}
if not sys.stdout.isatty():
    C = {k: "" for k in C}

# Brain-open canon (Chief, 2026-08-06): identity repos deliberately track the
# ENTIRE vault plus skills/plugins, so they are no longer tiny. The runaway
# threshold below is a canary for accidental tree adds, not a size policy.
TRACKED_WARN_THRESHOLD = 5000
# Filename patterns that are credential PAYLOADS (not files merely named after
# tokens — docs about tokens are first-class under Brain-open; the content scan
# below is what guards actual values).
SECRET_FILE_RE = re.compile(r"(^|/)\.env($|\.)|auth\.json|google_token|\.git-credentials|"
                            r"id_rsa|id_ed25519|\.pem$|\.key$|\.p12$|\.pfx$|\.kdbx$", re.I)
# Machine-state stores never belong in git history; ordinary media assets in
# the vault/skills are allowed under Brain-open.
BINARY_TRACKED_RE = re.compile(r"\.(pglite|sqlite|sqlite3|db|gguf|safetensors|pt|pth|onnx)$", re.I)
TRACKED_TREE_DENY_RE = re.compile(r"^(workspace/|\.hermes/honcho/|\.home/|\.cache/|\.npm/)")
# High-confidence LIVE credential shapes (not name matches — actual values).
# Deliberately conservative: formats that are never legitimate doc examples.
# Generic `sk-…` is excluded — docs use `sk-xxx…` placeholders constantly.
SECRET_CONTENT_PATTERNS = {
    "telegram-bot-token": re.compile(r"\b\d{8,10}:AA[A-Za-z0-9_-]{33}\b"),
    "bws-machine-token": re.compile(r"\b0\.[a-f0-9]{8}-[a-f0-9-]{27}\.[A-Za-z0-9]{20,}\b"),
    "github-pat": re.compile(r"\b(?:ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,})\b"),
    "anthropic-key": re.compile(r"\bsk-ant-[A-Za-z0-9-]{20,}\b"),
    "slack-token": re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b"),
    "private-key-block": re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----"),
}
SECRET_SCAN_MAX_BYTES = 2 * 1024 * 1024


class Report:
    def __init__(self):
        self.fails = 0
        self.warns = 0
        self.passes = 0

    def line(self, level, agent, msg, detail=""):
        sym = {"P": "✓", "W": "⚠", "F": "✗"}[level]
        col = C[level]
        if level == "P":
            self.passes += 1
        elif level == "W":
            self.warns += 1
        else:
            self.fails += 1
        if level == "P" and QUIET:
            return
        d = f"  {C['D']}{detail}{C['x']}" if detail else ""
        print(f"  {col}{sym}{C['x']} {msg}{d}")


def conf_value(repo, key):
    """Read one KEY=value from superhermes.conf (operator overrides) falling
    back to superhermes.conf.example. $VARS and ~ are expanded."""
    for name in ("superhermes.conf", "superhermes.conf.example"):
        p = repo / name
        if p.exists():
            m = re.search(rf'^\s*{key}\s*=\s*["\']?([^"\'\n#]+)', p.read_text(), re.M)
            if m:
                v = m.group(1).strip()
                if v:
                    return os.path.expanduser(os.path.expandvars(v))
    return None


def resolve_root(args, repo):
    if args.root:
        return Path(args.root)
    if os.environ.get("AGENTS_ROOT"):
        return Path(os.environ["AGENTS_ROOT"])
    v = conf_value(repo, "AGENTS_ROOT")
    if v:
        return Path(v)
    sys.exit("verify-agents: cannot resolve AGENTS_ROOT (use --root, $AGENTS_ROOT, or superhermes.conf)")


def load_contract_state(repo):
    """Optional runtime-contract enrollment state: a JSON file written by the
    deployment's runtime reconciler mapping agent ids → {incident, healthy_at}.
    Configured via $RUNTIME_CONTRACT_STATE or superhermes.conf; a lone agent
    (no reconciler) leaves it unset and the enrollment checks are skipped."""
    path = os.environ.get("RUNTIME_CONTRACT_STATE") or conf_value(repo, "RUNTIME_CONTRACT_STATE")
    if not path:
        return None, None
    p = Path(path)
    if not p.exists():
        return None, f"configured but missing: {p}"
    try:
        agents = json.loads(p.read_text()).get("agents", {})
        return (agents if isinstance(agents, dict) else {}), None
    except Exception as e:
        return None, f"unreadable: {e}"


def discover_agents(root):
    out = []
    if not root.is_dir():
        sys.exit(f"verify-agents: AGENTS_ROOT not a directory: {root}")
    for d in sorted(root.iterdir()):
        if not d.is_dir() or d.name.startswith((".", "_")) or d.name == "Shared":
            continue
        profiles = d / ".hermes" / "profiles"
        if not profiles.is_dir():
            continue
        # the agent's own profile = the profile dir whose config.yaml exists and
        # matches the lowercased agent name (skip *-staging etc.)
        slug = d.name.lower().replace("divinci", "divinci")  # identity; slug = lower(name)
        if (profiles / slug / "config.yaml").exists():
            out.append((d.name, slug, d))
    return out


def git(root, *args):
    try:
        return subprocess.run(["git", "-C", str(root), *args], text=True,
                              capture_output=True, timeout=30).stdout
    except Exception:
        return ""


def _short(s, n=120):
    s = " ".join(s.split())
    return s if len(s) <= n else s[: n - 1] + "…"


def _gbrain_serve_running(root):
    """True if a `gbrain serve` process is live for this agent (it legitimately
    holds the single-writer pglite lock, so its postmaster.pid is NOT stale)."""
    try:
        out = subprocess.run(["ps", "-axo", "command"], text=True,
                             capture_output=True, timeout=10).stdout
        return any("gbrain" in l and "serve" in l and str(root) in l
                   for l in out.splitlines())
    except Exception:
        return False


def check_agent(name, slug, root, rpt, config_versions, contract_agents):
    print(f"\n{C['H']}━━ {name} ({slug}) ━━{C['x']}")
    profile = root / ".hermes" / "profiles" / slug

    # 1. structure / isolation
    sb = root / ".hermes" / "sandbox" / f"{slug}.sb"
    rpt.line("P" if sb.exists() else "F", name, f"sandbox profile {slug}.sb", "" if sb.exists() else "MISSING")

    # 2. own GBrain wrapper + config points at own pglite (not shared)
    wrap = root / ".local" / "bin" / "gbrain"
    if not (wrap.exists() and os.access(wrap, os.X_OK)):
        rpt.line("F", name, "own GBrain wrapper (.local/bin/gbrain)", "MISSING or not executable")
    else:
        rpt.line("P", name, "own GBrain wrapper present")
    cfg = profile / "home" / ".gbrain" / "config.json"
    engine = None
    if cfg.exists():
        try:
            gc = json.loads(cfg.read_text())
            engine = gc.get("engine") or "pglite"
            if engine == "postgres":
                # store contract: an explicit per-agent database_url whose
                # server answers. Isolation (distinct db per agent) is asserted
                # across all agents once collected.
                db_url = gc.get("database_url") or gc.get("databaseUrl") or ""
                u = urlparse(db_url) if db_url else None
                if not db_url or not u.hostname:
                    rpt.line("F", name, "GBrain postgres database_url",
                             f"missing or unparsable: {db_url!r}")
                else:
                    host, port = u.hostname, u.port or 5432
                    STORE_IDS[name] = (host, port, (u.path or "").lstrip("/"))
                    try:
                        with socket.create_connection((host, port), timeout=3):
                            rpt.line("P", name, f"GBrain postgres reachable ({host}:{port})")
                    except OSError as e:
                        rpt.line("F", name, "GBrain postgres reachable",
                                 f"{host}:{port} — {e}")
            else:
                # pglite (lone-agent default): store must live inside the
                # agent's own profile, never a shared path.
                db = gc.get("database_path", "")
                if "Shared/" in db or "/.gbrain/" not in db:
                    rpt.line("F", name, "GBrain store path", f"not profile-isolated: {db}")
                else:
                    rpt.line("P", name, "GBrain store profile-isolated")
            # embedding endpoint must be the OpenAI-compatible /v1 base (canon)
            eb = (gc.get("embedding_base_url", "") or "").rstrip("/")
            rpt.line("P" if eb.endswith("/v1") else "F", name,
                     "GBrain embedding_base_url is /v1",
                     "" if eb.endswith("/v1") else f"got {gc.get('embedding_base_url')!r}")
        except Exception as e:
            rpt.line("F", name, "GBrain config.json parse", str(e))
    else:
        rpt.line("W", name, "GBrain config.json", "not found")

    # 2b. the definitive regression test: the brain actually OPENS and reads,
    # via the agent's OWN wrapper — for postgres this is the real per-agent
    # store-reachability proof (auth + database exist, not just a TCP port).
    # pglite background: a corrupted WAL (unclean shutdown) makes PGLite's WASM
    # abort on open — the exact failure that took down DiVinci/Iris/Neo on
    # 2026-06-04. gbrain's CLI leaves a postmaster.pid behind after any access,
    # so the pid file ALONE is not a corruption signal — only pid + failed open
    # is. We skip the open when a live serve holds the single-writer pglite.
    pglite = profile / "home" / ".gbrain" / "brain.pglite"
    pidf = pglite / "postmaster.pid"
    if not (wrap.exists() and os.access(wrap, os.X_OK)):
        pass  # wrapper failure already reported above
    elif engine != "postgres" and pidf.exists() and _gbrain_serve_running(root):
        rpt.line("P", name, "GBrain brain held open by live serve")
    elif engine == "postgres" or pglite.exists():
        try:
            out = subprocess.run([str(wrap), "list", "-n", "1"],
                                 text=True, capture_output=True, timeout=25)
            blob = out.stdout + out.stderr
            if "WASM" in blob or "Aborted(" in blob:
                rpt.line("F", name, "GBrain brain opens",
                         "PGLite WASM abort — corrupted WAL; run gbrain-guardian to heal")
            elif out.returncode != 0 and "No brain" not in blob:
                rpt.line("W", name, "GBrain brain opens", _short(blob))
            else:
                rpt.line("P", name, "GBrain brain opens + reads")
        except subprocess.TimeoutExpired:
            rpt.line("W", name, "GBrain brain opens", "timeout opening store")

    # 2d. record gbrain binary version for the cross-agent drift check
    if wrap.exists() and os.access(wrap, os.X_OK):
        try:
            v = subprocess.run([str(wrap), "--version"], text=True,
                               capture_output=True, timeout=15)
            mv = re.search(r"(\d+\.\d+\.\d+)", v.stdout)
            GBRAIN_VERSIONS[name] = mv.group(1) if mv else "?"
        except Exception:
            GBRAIN_VERSIONS[name] = "ERR"

    # 3. scripts must invoke the agent's OWN gbrain CLI, never one from outside
    # its root (a retired shared shim hardcoded another agent's binary — silent
    # version/runtime drift). Matches only the bare `.../bin/gbrain` CLI; sibling
    # tools like gbrain-autosync / gbrain-capture-audit are fine.
    scripts = profile / "scripts"
    foreign_cli_re = re.compile(r"(\S*/bin/gbrain)(?![\w.-])")
    bad_shared = []
    if scripts.is_dir():
        for f in scripts.rglob("*"):
            if f.is_file():
                try:
                    for ref in foreign_cli_re.findall(f.read_text(errors="ignore")):
                        if not ref.startswith(str(root)):
                            bad_shared.append(f"{f.name} → {ref}")
                except Exception:
                    pass
    rpt.line("F" if bad_shared else "P", name, "no foreign gbrain-CLI refs in scripts (own wrapper only)",
             "; ".join(dict.fromkeys(bad_shared)))

    # 4 & 5. cron referential integrity + no retired-system refs
    jobs_path = profile / "cron" / "jobs.json"
    missing_scripts, localmem_jobs, honcho_jobs = [], [], []
    if jobs_path.exists():
        try:
            jobs = json.loads(jobs_path.read_text()).get("jobs", [])
        except Exception as e:
            jobs = []
            rpt.line("F", name, "cron/jobs.json parse", str(e))
        for j in jobs:
            scr = j.get("script")
            if scr and not (scripts / scr).exists():
                missing_scripts.append(f"{j.get('name','?')} → {scr}")
            prompt = j.get("prompt") or ""
            # Only flag references to the agent's OWN profile scripts dir — a bare
            # "scripts/x.sh" usually points inside a project repo the agent builds,
            # not a profile cron script. (Caught the real iris_auto_commit.sh bug,
            # whose prompt said ~/.hermes/profiles/iris/scripts/iris_auto_commit.sh.)
            for m in re.findall(r"profiles/[\w-]+/scripts/([\w.-]+\.(?:sh|py))", prompt):
                if not (scripts / m).exists():
                    missing_scripts.append(f"{j.get('name','?')} → profile scripts/{m}")
            if j.get("enabled") and re.search(r"localmem_(profile|forget)", prompt):
                localmem_jobs.append(j.get("name", "?"))
            # Honcho was decommissioned; prompts steering agents at it waste
            # turns against a dead service. Advisory (WARN) — prose mentions
            # are drift, not breakage.
            if j.get("enabled") and re.search(r"honcho", prompt, re.I):
                honcho_jobs.append(j.get("name", "?"))
        rpt.line("F" if missing_scripts else "P", name, "cron scripts all exist",
                 "; ".join(dict.fromkeys(missing_scripts)))
        rpt.line("F" if localmem_jobs else "P", name, "no retired-LocalMem refs in active crons",
                 ", ".join(localmem_jobs))
        rpt.line("W" if honcho_jobs else "P", name, "no retired-Honcho refs in active crons",
                 ", ".join(dict.fromkeys(honcho_jobs)))
        # baseline coverage (advisory): a memory-maintenance job + a git-sync job
        blob = " ".join((j.get("name", "") + " " + (j.get("script") or "") + " " + (j.get("skill") or "")).lower()
                        for j in jobs if j.get("enabled"))
        for present, label in [
            (re.search(r"maintenance|consolidat|hygiene|memory_health_snapshot|memory-architecture", blob), "memory maintenance"),
            ("git-sync" in blob, "git-sync"),
        ]:
            rpt.line("P" if present else "W", name, f"baseline cron present: {label}",
                     "" if present else "missing")
    else:
        rpt.line("W", name, "cron/jobs.json", "not found")

    # 6. git repo + normalised gitignore + no tracked secrets/bloat
    if (root / ".git").is_dir():
        gi = root / ".gitignore"
        if gi.exists() and "SuperHermes normalised standard" in gi.read_text():
            rpt.line("P", name, "normalised .gitignore present")
        else:
            rpt.line("F", name, "normalised .gitignore", "missing or non-standard")
        tracked = [t for t in git(root, "ls-files").splitlines() if t]
        leaks = [t for t in tracked
                 if SECRET_FILE_RE.search(t) or BINARY_TRACKED_RE.search(t) or TRACKED_TREE_DENY_RE.search(t)]
        rpt.line("F" if leaks else "P", name, "no secrets/binaries/excluded-trees tracked",
                 f"{len(leaks)} offending: " + ", ".join(leaks[:5]) if leaks else "")
        if len(tracked) > TRACKED_WARN_THRESHOLD:
            rpt.line("W", name, "tracked-file count sane", f"{len(tracked)} files (>{TRACKED_WARN_THRESHOLD})")
        else:
            rpt.line("P", name, f"tracked-file count sane ({len(tracked)})")
        # 6b. content scan: no LIVE credential values in any tracked file.
        # Filename rules can't catch a token pasted into config.yaml — this can.
        # Reports file + pattern name only, never the value.
        live_secrets = []
        for t in tracked:
            fp = root / t
            try:
                if not fp.is_file() or fp.stat().st_size > SECRET_SCAN_MAX_BYTES:
                    continue
                text = fp.read_text(errors="ignore")
            except Exception:
                continue
            for pname, rx in SECRET_CONTENT_PATTERNS.items():
                if rx.search(text):
                    live_secrets.append(f"{t} [{pname}]")
        rpt.line("F" if live_secrets else "P", name, "no live credential values in tracked files",
                 "; ".join(live_secrets[:5]) + ("…" if len(live_secrets) > 5 else ""))
    else:
        rpt.line("F", name, "root git repo (.git)", "MISSING")

    # 7. no retired-Honcho artifacts: Honcho was decommissioned (2026-07-15);
    # a lingering honcho.json is dead config that misleads tooling.
    hj = profile / "honcho.json"
    rpt.line("W" if hj.exists() else "P", name,
             "no retired honcho.json (Honcho decommissioned)",
             "still present — remove" if hj.exists() else "")

    # 7b. runtime-contract enrollment (only when a reconciler is configured —
    # see RUNTIME_CONTRACT_STATE in superhermes.conf; lone agents skip this).
    if contract_agents is not None:
        entry = contract_agents.get(slug)
        if entry is None:
            entry = next((v for k, v in contract_agents.items()
                          if k == slug or k.endswith(f":{slug}")), None)
        if not isinstance(entry, dict):
            rpt.line("F", name, "runtime-contract enrollment", "no state entry for this agent")
        elif entry.get("incident"):
            rpt.line("F", name, "runtime-contract healthy", f"open incident: {_short(json.dumps(entry['incident']))}")
        else:
            age_h = None
            try:
                ts = datetime.fromisoformat(str(entry.get("healthy_at")))
                if ts.tzinfo is None:
                    ts = ts.replace(tzinfo=timezone.utc)
                age_h = (datetime.now(timezone.utc) - ts).total_seconds() / 3600
            except Exception:
                pass
            if age_h is None:
                rpt.line("W", name, "runtime-contract healthy", f"unparsable healthy_at: {entry.get('healthy_at')!r}")
            elif age_h > 24:
                rpt.line("W", name, "runtime-contract healthy", f"last healthy {age_h:.0f}h ago — reconciler stale?")
            else:
                rpt.line("P", name, "runtime-contract enrolled + healthy")

    # 8. config version (collect for cross-agent consistency check)
    conf = profile / "config.yaml"
    if conf.exists():
        m = re.search(r"_config_version:\s*(\d+)", conf.read_text())
        config_versions[name] = m.group(1) if m else "?"
    else:
        rpt.line("F", name, "config.yaml", "MISSING")

    # 9. gateway plist KeepAlive (macOS; soft — skip if absent)
    plist = Path.home() / "Library" / "LaunchAgents" / f"ai.hermes.gateway-{slug}.plist"
    if plist.exists():
        try:
            ka = plistlib.loads(plist.read_bytes()).get("KeepAlive")
            # Standard: KeepAlive must be literal `true` (always restart).
            # A restart-policy dict like {SuccessfulExit: false} only respawns on a
            # *failed* exit, so a graceful/clean shutdown (e.g. an internal
            # restart_requested drain) strands the gateway: launchd honours the
            # clean exit, and gateway_healer defers process liveness to launchd.
            # That double-gap took CW Jeeves down ~11h on 2026-06-06. Require true
            # so clean exits also respawn; a dict or absent KeepAlive is a miss.
            ok = ka is True
            rpt.line("P" if ok else "W", name, "gateway plist KeepAlive (always-restart)",
                     "" if ok else f"is {ka!r} (expected true so clean exits also respawn)")
        except Exception as e:
            rpt.line("W", name, "gateway plist parse", str(e))


def main():
    global QUIET
    ap = argparse.ArgumentParser(description="Verify SuperHermes invariants across every agent.")
    ap.add_argument("--root"); ap.add_argument("--agent"); ap.add_argument("--quiet", action="store_true")
    args = ap.parse_args()
    QUIET = args.quiet
    repo = Path(__file__).resolve().parent.parent
    root = resolve_root(args, repo)
    agents = discover_agents(root)
    if args.agent:
        agents = [a for a in agents if a[0].lower() == args.agent.lower()]
        if not agents:
            sys.exit(f"verify-agents: agent '{args.agent}' not found under {root}")

    contract_agents, contract_err = load_contract_state(repo)

    print(f"{C['H']}SuperHermes agent check{C['x']}  root={root}  agents={len(agents)}")
    rpt = Report()
    config_versions = {}
    for name, slug, droot in agents:
        check_agent(name, slug, droot, rpt, config_versions, contract_agents)

    # cross-agent: config version consistency
    print(f"\n{C['H']}━━ cross-agent ━━{C['x']}")
    if contract_err:
        rpt.line("F", "*", "runtime-contract state file", contract_err)
    elif contract_agents is None:
        print(f"  {C['D']}runtime-contract: not configured (RUNTIME_CONTRACT_STATE) — enrollment checks skipped{C['x']}")

    # cross-agent: postgres store isolation — no two agents may share a database
    dup = {}
    for a, sid in STORE_IDS.items():
        dup.setdefault(sid, []).append(a)
    shared = {sid: names for sid, names in dup.items() if len(names) > 1}
    if STORE_IDS:
        if shared:
            detail = "; ".join(f"{h}:{p}/{db} ← {', '.join(names)}" for (h, p, db), names in shared.items())
            rpt.line("F", "*", "gbrain store database distinct per agent", detail)
        else:
            rpt.line("P", "*", f"gbrain store database distinct per agent ({len(STORE_IDS)} postgres)")
    vers = set(config_versions.values())
    if len(vers) <= 1:
        rpt.line("P", "*", f"config versions consistent ({', '.join(vers) or 'n/a'})")
    else:
        detail = ", ".join(f"{a}={v}" for a, v in sorted(config_versions.items()))
        rpt.line("F", "*", "config versions consistent across agents", f"DRIFT: {detail}")

    # cross-agent: gbrain binary version consistency
    gv = {v for v in GBRAIN_VERSIONS.values() if v not in ("?", "ERR")}
    if len(gv) <= 1:
        rpt.line("P", "*", f"gbrain binary versions consistent ({', '.join(gv) or 'n/a'})")
    else:
        detail = ", ".join(f"{a}={v}" for a, v in sorted(GBRAIN_VERSIONS.items()))
        rpt.line("W", "*", "gbrain binary versions consistent across agents", f"DRIFT: {detail}")

    print(f"\n{C['H']}Summary{C['x']}  "
          f"{C['P']}{rpt.passes} pass{C['x']}  {C['W']}{rpt.warns} warn{C['x']}  {C['F']}{rpt.fails} fail{C['x']}")
    sys.exit(1 if rpt.fails else 0)


if __name__ == "__main__":
    main()
