#!/usr/bin/env python3
"""Set one top-level Hermes display.busy_input_mode value without YAML reserialization."""

from __future__ import annotations

import os
import re
import stat
import sys
import tempfile
from pathlib import Path

VALID_MODES = {"interrupt", "queue", "steer"}
DISPLAY_HEADER = re.compile(r"^display:\s*(?:#.*)?$")
ANY_DISPLAY_HEADER = re.compile(r"^(?:display|['\"]display['\"])\s*:")
TOP_LEVEL_KEY = re.compile(r"^[^\s#][^:]*:")
BUSY_MODE_KEY = re.compile(
    r"^(?P<indent>[ \t]+)busy_input_mode:\s*(?P<value>[^\s#]+)(?P<suffix>\s*(?:#.*)?)$"
)
ANY_BUSY_MODE_KEY = re.compile(
    r"^[ \t]+(?:busy_input_mode|['\"]busy_input_mode['\"])\s*:"
)


def set_busy_input_mode(path: Path, mode: str) -> bool:
    if mode not in VALID_MODES:
        raise ValueError(f"mode must be one of: {', '.join(sorted(VALID_MODES))}")
    if path.is_symlink() or not path.is_file():
        raise ValueError(f"config must be a regular file: {path}")

    original_bytes = path.read_bytes()
    if original_bytes.startswith(b"\xef\xbb\xbf"):
        raise ValueError("UTF-8 byte-order marks are unsupported")
    if b"\r" in original_bytes:
        raise ValueError("config must use LF line endings")
    original = original_bytes.decode("utf-8")
    trailing_newline = original.endswith("\n")
    lines = original.splitlines()
    unsupported_display_indexes = [
        index
        for index, line in enumerate(lines)
        if ANY_DISPLAY_HEADER.match(line) and not DISPLAY_HEADER.match(line)
    ]
    if unsupported_display_indexes:
        raise ValueError("display must use a top-level block mapping")
    display_indexes = [index for index, line in enumerate(lines) if DISPLAY_HEADER.match(line)]
    if len(display_indexes) > 1:
        raise ValueError("config contains more than one top-level display block")

    if display_indexes:
        display_index = display_indexes[0]
        block_end = len(lines)
        for index in range(display_index + 1, len(lines)):
            if TOP_LEVEL_KEY.match(lines[index]):
                block_end = index
                break
        any_busy_indexes = [
            index
            for index in range(display_index + 1, block_end)
            if ANY_BUSY_MODE_KEY.match(lines[index])
        ]
        busy_indexes = [
            index
            for index in range(display_index + 1, block_end)
            if BUSY_MODE_KEY.match(lines[index])
        ]
        if len(any_busy_indexes) != len(busy_indexes):
            raise ValueError("busy_input_mode must have a scalar value")
        if len(busy_indexes) > 1:
            raise ValueError("display block contains more than one busy_input_mode key")
        if busy_indexes:
            index = busy_indexes[0]
            match = BUSY_MODE_KEY.match(lines[index])
            assert match is not None
            existing_value = match.group("value")
            quote = ""
            if (
                len(existing_value) >= 2
                and existing_value[0] in {"'", '"'}
                and existing_value[-1] == existing_value[0]
            ):
                quote = existing_value[0]
                scalar_value = existing_value[1:-1]
            else:
                scalar_value = existing_value
            if scalar_value not in VALID_MODES:
                raise ValueError("existing busy_input_mode must be a supported scalar mode")
            replacement_value = f"{quote}{mode}{quote}"
            lines[index] = (
                f"{match.group('indent')}busy_input_mode: "
                f"{replacement_value}{match.group('suffix')}"
            )
        else:
            lines.insert(display_index + 1, f"  busy_input_mode: {mode}")
    else:
        if lines and lines[-1] != "":
            lines.append("")
        lines.extend(["display:", f"  busy_input_mode: {mode}"])

    updated = "\n".join(lines) + ("\n" if trailing_newline or lines else "")
    if updated == original:
        return False

    current_mode = stat.S_IMODE(path.stat().st_mode)
    temporary_name = ""
    try:
        with tempfile.NamedTemporaryFile(
            "w",
            encoding="utf-8",
            dir=path.parent,
            prefix=f".{path.name}.",
            delete=False,
        ) as temporary:
            temporary.write(updated)
            temporary.flush()
            os.fsync(temporary.fileno())
            temporary_name = temporary.name
        os.chmod(temporary_name, current_mode)
        os.replace(temporary_name, path)
    finally:
        if temporary_name:
            try:
                os.unlink(temporary_name)
            except FileNotFoundError:
                pass
    return True


def main(argv: list[str]) -> int:
    if len(argv) != 3:
        print(f"usage: {argv[0]} <config.yaml> <interrupt|queue|steer>", file=sys.stderr)
        return 2
    try:
        set_busy_input_mode(Path(argv[1]), argv[2])
    except (OSError, UnicodeError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
