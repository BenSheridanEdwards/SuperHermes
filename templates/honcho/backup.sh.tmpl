#!/bin/sh
# Nightly Postgres backup for __PROJECT__ (SuperHermes Honcho stack).
# Runs via launchd. Keeps KEEP_DAYS of pg_dump in honcho/backups/.
set -eu

BACKUP_DIR="__HONCHO_DIR__/backups"
PROJECT="__PROJECT__"
DB_CONTAINER="${PROJECT}-database-1"
KEEP_DAYS=7
STAMP="$(date -u +'%Y-%m-%dT%H%M%SZ')"
OUT="${BACKUP_DIR}/${PROJECT}-${STAMP}.sql.gz"
LOG="${BACKUP_DIR}/backup.log"

mkdir -p "$BACKUP_DIR"
{
  echo "=== ${STAMP} backup start ==="
  if ! docker ps --format '{{.Names}}' | grep -q "^${DB_CONTAINER}\$"; then
    echo "ERROR: database container ${DB_CONTAINER} not running; skipping backup"
    exit 1
  fi
  docker exec "$DB_CONTAINER" pg_dump -U postgres -d postgres --no-owner --no-acl | gzip > "$OUT"
  SIZE=$(stat -f%z "$OUT" 2>/dev/null || stat -c%s "$OUT")
  echo "wrote ${OUT} (${SIZE} bytes)"
  find "$BACKUP_DIR" -name "${PROJECT}-*.sql.gz" -type f -mtime "+${KEEP_DAYS}" -print -delete
  echo "=== ${STAMP} backup done ==="
} >> "$LOG" 2>&1
