# Honcho .env for __PROJECT__ — three-tier memory model.
#
# Honcho runs several LLM workloads at different latency/cost points. The blueprint
# is a 3-tier model; pick providers per tier, then set each agent's CEILING.
#
#   Tier S  (always-on, local)   — Deriver, Summary, Dialectic minimal/low.
#                                  Fast + free. Use a small local model (Ollama).
#   Tier M  (on-demand, cloud)   — Dialectic medium/high. User-facing depth.
#   Tier L  (on-demand + nightly)— Dialectic max + Dreams. Deepest reasoning.
#
# Per-agent CEILING decides how far medium/high/max climb:
#   High    → max + dreams on the Tier-L reasoning model
#   Medium  → dialectic clamps to Tier-M; dreams still Tier-L
#   Low     → dialectic stays local (Tier-S); dreams on Tier-M
# (This agent's tier choice: __TIER__)

NAMESPACE=__PROJECT__

# Embeddings — keep this dimension identical across every agent in a fleet.
EMBEDDING_VECTOR_DIMENSIONS=768

# ── Tier S: always-on local (replace granite/ollama with your local model) ──
DERIVER_MODEL_CONFIG__MODEL=granite4.1:3b-ctx32k
SUMMARY_MODEL_CONFIG__MODEL=granite4.1:3b-ctx32k
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=granite4.1:3b-ctx8k
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=granite4.1:3b-ctx8k
DERIVER_FLUSH_ENABLED=true

# ── Tier M / L: set per this agent's ceiling (examples shown commented) ──
# High ceiling:
#   DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=<tier-M cloud model>
#   DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=<tier-M cloud model>
#   DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=<tier-L reasoning model>
#   DREAM_DEDUCTION_MODEL_CONFIG__MODEL=<tier-L reasoning model>
#   DREAM_INDUCTION_MODEL_CONFIG__MODEL=<tier-L reasoning model>
# (cloud slots also take __OVERRIDES__BASE_URL, __API_KEY, __TRANSPORT)
#
# In a real fleet, keep these in sync from one matrix (see SuperHermes docs:
# 04-memory-architecture). Dream cadence is set per agent (e.g. 6–24h).
