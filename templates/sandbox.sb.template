(version 1)

;; SuperHermes minimal sandbox for __AGENT_NAME__.
;;
;; Boundary requested by Chief:
;; - Allow normal macOS, browser, GPU, app, temp, and runtime operations.
;; - Do not read or write /Users/Shared.
;; - Do not read or write other macOS user homes.
;; - Do not write in another agent's root under __AGENTS_ROOT__.
;;
;; This is not a filesystem allowlist and does not confine the agent to
;; /Users/agents.

(allow default)

;; Native GUI/rendering tools create their own macOS sandboxes. Do not make them
;; inherit the Hermes file sandbox, or QuickLook/Chromium sandbox init fails.
(allow process-exec* (with no-sandbox)
  (subpath "/System/Library/Frameworks/QuickLook.framework")
  (subpath "/Applications/Brave Browser.app"))

;; macOS user boundary.
(deny file* (literal "/Users/Shared"))
(deny file* (subpath "/Users/Shared"))
__OTHER_USER_HOME_RULES__

;; Agent boundary: reads are allowed, writes into other agent roots are not.
__OTHER_AGENT_WRITE_RULES__
