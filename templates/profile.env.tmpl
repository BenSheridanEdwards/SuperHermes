# Profile environment + secrets for __AGENT_NAME__.
#
# SECRETS — never commit this file (the profile .gitignore excludes it).
# Two ways to fill it, your choice — SuperHermes is backend-agnostic:
#   1. Paste values here directly (simplest).
#   2. Leave blank and source them from a secrets manager via config.yaml
#      `secrets:` — Hermes ships BitWarden Secrets Manager support; any backend
#      that exports env vars works. The agent only needs the KEYS below to exist;
#      it doesn't care where the values come from.

# ── Telegram gateway ─────────────────────────────────────────────────────────
# Create a bot once via @BotFather (/newbot → name → @username → it returns a
# token). Paste the token here, or store it in your secrets manager under this key.
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_CHANNEL=
TELEGRAM_ALLOWED_USERS=

# ── GitHub (optional) ────────────────────────────────────────────────────────
GITHUB_TOKEN=
GH_TOKEN=

# ── Google Workspace (optional) ──────────────────────────────────────────────
GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE=__AGENT_ROOT__/.hermes/profiles/__AGENT_SLUG__/google_token.json
