# SuperHermes — operator config (copy to `superhermes.conf`, which is gitignored).
# These are the machine-specific values that must NOT live in the public repo.

# Root directory that holds one folder per agent (each folder is an agent "home").
AGENTS_ROOT="$HOME/Agents"

# Shared skills library each agent is wired to read (Hermes `skills.external_dirs`).
SKILLS_DIR="$AGENTS_ROOT/Shared/skills"

# GBrain CLI wrapper (semantic/wiki brain). Leave blank to skip GBrain wiring.
GBRAIN_BIN="$AGENTS_ROOT/Shared/bin/gbrain"

# Python venv that runs the Hermes gateway.
HERMES_VENV="$HOME/.hermes/hermes-agent/venv"

# Optional: clone a new agent's config.yaml/.env from an existing agent instead
# of the bundled generic templates. Leave blank to use bundled templates.
REF_AGENT=""

# Common dirs (e.g. a shared ops folder) that stay read+write for every agent
# even though they live under AGENTS_ROOT. Space-separated. Leave blank for none.
COMMON_DIRS=""

# ── Sandbox carve-outs (optional; town-square model) ─────────────────────────
# Absolute paths the sandbox must DENY to every agent (e.g. the human operator's
# own macOS home). Space-separated. Leave blank for none.
PROTECTED_PATHS=""

# Optional "need-to-know" path: readable only by the agents listed in
# VAULT_READERS (space-separated slugs); denied to all others. Leave blank to skip.
VAULT_PATH=""
VAULT_READERS=""
