# SuperHermes — operator config (copy to `superhermes.conf`, which is gitignored).
# These are the machine-specific values that must NOT live in the public repo.

# Root directory that holds one folder per agent (each folder is an agent "home").
AGENTS_ROOT="$HOME/Agents"

# Shared skills library each agent is wired to read (Hermes `skills.external_dirs`).
SKILLS_DIR="$AGENTS_ROOT/Shared/skills"

# GBrain: each agent gets its OWN profile-isolated v0.41 runtime + wrapper at
# <agent>/.local/bin/gbrain (installed by new-agent). No shared/global path needed.

# Python venv that runs the Hermes gateway.
HERMES_VENV="$HOME/.hermes/hermes-agent/venv"

# Optional: clone a new agent's config.yaml/.env from an existing agent instead
# of the bundled generic templates. Leave blank to use bundled templates.
REF_AGENT=""

# Sandbox policy is intentionally not configurable here. Generated profiles use
# allow-default and enforce only: no /Users/Shared access, no other macOS user
# homes, and no writes into another agent root under AGENTS_ROOT.
